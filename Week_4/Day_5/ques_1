//symmetric tree

class Solution {
    bool issymmetricnew(TreeNode* left, TreeNode* right)
    { 
        if(left==NULL || right==NULL) return left==right;
        if(left->val!=right->val) return false;
        return (issymmetricnew(left->left, right->right) && issymmetricnew(left->right, right->left));
    }
public:
    bool isSymmetric(TreeNode* root) {
        if (root==NULL) return true;
        return issymmetricnew(root->left, root->right);
    }
};
