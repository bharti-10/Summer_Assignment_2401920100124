//valid anagram

class Solution {
public:
    bool isAnagram(string s, string t) {
       
        int s1= s.length();
        int s2= t.length();
        if(s1!=s2)return false;
        sort(s.begin() , s.end());
        sort(t.begin() , t .end());
        if(s==t) return true; 
        else return false;

    }
};
