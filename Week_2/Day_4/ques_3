// generate parenthesis

class Solution {

    

public:
void pare(int close, int open , string curr,int n , vector<string>&ans )
    {
        if(curr.size()==2*n)
        {
            ans.push_back(curr);
            return ;
        }
        if(open<n)
        {
            curr.push_back('(');
            pare(close, open+1,  curr, n , ans);
            curr.pop_back();
        }
        if(close<open)
        {
             curr.push_back(')');
            pare(close+1, open,  curr, n , ans);
            curr.pop_back();
        }
        
    }
    vector<string> generateParenthesis(int n) {
        vector<string>ans;
        int open=0;
        int close=0;
        string curr="";
        pare(close, open, curr, n, ans);
        return ans;
    }
};
