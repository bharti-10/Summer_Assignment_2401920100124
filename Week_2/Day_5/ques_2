//string compression
class Solution {
public:
    int compress(vector<char>& chars) {
        int n=chars.size();
        int ptr=0;
        if(chars.size()==1) return 1;
        int cnt=1;
        for(int i=1;i<n;i++)
        {
            if(chars[i]==chars[i-1] )
            {
                cnt++;
                continue;
            }
           chars[ptr]=chars[i-1];
           ptr++;
            if(cnt>1 && cnt<=9)
            {
            chars[ptr] = cnt + '0';
            ptr++;
            }
            else if(cnt>=10)
            {
            string s= to_string(cnt);
            for(char ch: s)
            {
                chars[ptr++]=ch;
            }
            }
            cnt=1;
            
        }
        chars[ptr++] = chars[n-1];

if(cnt > 1)
{
    string s = to_string(cnt);

    for(char ch : s)
    {
        chars[ptr++] = ch;
    }
}
        return ptr;
    }
};
