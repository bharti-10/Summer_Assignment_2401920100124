//construct BT from inorder and preorder

class Solution {
    TreeNode* solve(vector<int>& preorder,int prestart, int preend, vector<int>& inorder, int instart,int inend,  unordered_map<int, int>&mp)
    {
        if(prestart>preend || instart>inend) return NULL;
        TreeNode* node= new TreeNode(preorder[prestart]);
        int pos= mp[preorder[prestart]];
        int numsleft=pos-instart;
        node->left=solve(preorder,prestart+1, prestart+numsleft, inorder, instart,pos-1, mp);
        node->right=solve(preorder,prestart+numsleft+1, preend,inorder, pos+1, inend, mp);
        return node;
    }
public:
    TreeNode* buildTree(vector<int>& preorder, vector<int>& inorder) {
      unordered_map<int, int>mp;
       for(int i=0;i<inorder.size();i++)
       {
        mp[inorder[i]]=i;
       } 
      TreeNode* root= solve(preorder, 0, preorder.size()-1, inorder, 0, inorder.size()-1, mp);
      return root;
       
    }
};
