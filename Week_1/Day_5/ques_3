//longest common prefix

class Solution {
public:
    string longestCommonPrefix(vector<string>& strs) {
        if(strs.empty()) return "";
        sort(strs.begin() , strs.end());
        int n=strs.size();
        string s1=strs[0];
        string s2= strs[n-1];
        int n1=s1.size();
        int cnt=0;
        for(int i=0;i<n1;i++)
        {
            if(s1[i]==s2[i]) cnt++;
            else break;
        } 
        return s1.substr(0,cnt);
    }
};
