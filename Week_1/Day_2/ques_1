//MAXIMUM SUB ARRAY

class Solution {
public:
int maxi=INT_MIN;
int sum=0;
//kadane's
    int maxSubArray(vector<int>& nums) {
        for(int i=0;i<nums.size() ; i++)
        {
            sum+= nums[i];
            if(sum>maxi)
            {
                maxi=sum;
            }
            if(sum<0)
            {
                sum=0;
            }
        }
        return maxi;
    }
};
