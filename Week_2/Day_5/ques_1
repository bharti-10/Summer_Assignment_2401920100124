//group anagrams

class Solution {
public:
    vector<vector<string>> groupAnagrams(vector<string>& strs) {
        vector<vector<string>>ans;
        if(strs.size()==0)
        {
            return{{""}};
        }
        int n=strs.size();
       unordered_map<string, vector<string>>mp;
        for(auto it: strs)
        { 
            string str= it;
            sort(str.begin(), str.end());
             mp[str].push_back(it);
        }
        for(auto it: mp)
        {
            ans.push_back(it.second);
        }
        return ans;
    }
};
